---
// src/pages/marketing/video.astro - Video Production Services
import '../../styles/global.css';
---

<!doctype html>
<html lang="en" id="html-root">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title data-ko="홍보영상 제작 | WiseUp" data-en="Video Production | WiseUp">Video Production | WiseUp</title>
    <meta
      name="description"
      data-ko="토론토 소상공인과 리얼터를 위한 전문 홍보영상 제작 서비스. 브랜드 스토리를 영상으로 전달하세요."
      data-en="Professional video production for Toronto small businesses and realtors. Tell your brand story through video."
      content="Professional video production for Toronto small businesses and realtors. Tell your brand story through video."
    />
    <link rel="canonical" href="https://wiseupsolution.ca/marketing/video" />
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://wiseupsolution.ca/marketing/video" />
    <meta 
      property="og:title" 
      data-ko="홍보영상 제작 | WiseUp" 
      data-en="Video Production | WiseUp"
      content="Video Production | WiseUp" 
    />
    <meta 
      property="og:description" 
      data-ko="토론토 소상공인과 리얼터를 위한 전문 홍보영상 제작 서비스."
      data-en="Professional video production for Toronto small businesses and realtors."
      content="Professional video production for Toronto small businesses and realtors." 
    />
    <meta property="og:image" content="https://wiseupsolution.ca/images/og-video.png" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://wiseupsolution.ca/marketing/video" />
    <meta 
      name="twitter:title" 
      data-ko="홍보영상 제작 | WiseUp" 
      data-en="Video Production | WiseUp"
      content="Video Production | WiseUp" 
    />
    <meta 
      name="twitter:description" 
      data-ko="토론토 소상공인과 리얼터를 위한 전문 홍보영상 제작 서비스."
      data-en="Professional video production for Toronto small businesses and realtors."
      content="Professional video production for Toronto small businesses and realtors." 
    />
    <meta name="twitter:image" content="https://wiseupsolution.ca/images/og-video.png" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      /* Fullscreen Video Hero */
      .video-hero {
        position: relative;
        width: 100%;
        height: 100vh;
        min-height: 600px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }
      
      /* Terminal Typing Animation */
      :global(.typing-text) {
        display: inline;
      }
      
      :global(.typing-cursor) {
        display: inline-block;
        width: 3px;
        height: 0.85em;
        background-color: #ffffff;
        margin-left: 2px;
        vertical-align: middle;
        animation: cursorBlink 0.7s infinite;
      }
      
      @keyframes cursorBlink {
        0%, 50% {
          opacity: 1;
        }
        51%, 100% {
          opacity: 0;
        }
      }
      
      /* Hero fade-in elements */
      .hero-fade {
        opacity: 0;
        visibility: hidden;
        transform: translateY(20px);
        transition: opacity 0.6s ease-out, transform 0.6s ease-out, visibility 0.6s ease-out;
      }
      
      .hero-fade.visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }
      
      .video-hero-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 1;
      }

      /* Premium Gradient Text */
      :global(.video-gradient-text) {
        display: inline-block;
        color: #ffffff;
        background: linear-gradient(135deg, #ffcc00 0%, #fff3ad 50%, #ffcc00 100%);
        background-size: 200% auto;
        background-clip: text;
        -webkit-background-clip: text;
        transition: color 1s ease-in-out, -webkit-text-fill-color 1s ease-in-out;
      }

      :global(.video-gradient-text.active) {
        -webkit-text-fill-color: transparent;
        animation: shine 3s linear infinite;
        filter: drop-shadow(0 0 10px rgba(255, 204, 0, 0.3));
      }

      @keyframes shine {
        to {
          background-position: 200% center;
        }
      }
      
      .video-hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.4) 100%);
        z-index: 2;
      }
      
      .video-hero-content {
        position: relative;
        z-index: 3;
        text-align: center;
        color: white;
        max-width: 900px;
        padding: 80px 2rem 0;
      }
      
      @media (min-width: 768px) {
        .video-hero-content {
          padding: 0 2rem;
        }
      }
      
      .video-hero-content h1 {
        font-size: 1.875rem;
        font-weight: 800;
        margin-bottom: 1.5rem;
        line-height: 1.2;
      }
      
      @media (min-width: 768px) {
        .video-hero-content h1 {
          font-size: 3rem;
        }
      }
      
      @media (min-width: 1024px) {
        .video-hero-content h1 {
          font-size: 3.75rem;
        }
      }
      
      .video-hero-content p {
        font-size: 1.125rem;
        opacity: 0.95;
        margin-bottom: 2rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
        line-height: 1.6;
      }
      
      /* Mobile Menu styles */
      #mobile-menu {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: white;
        z-index: 990;
        transform: translateX(100%);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        padding-top: 6rem;
        padding-left: 2rem;
        padding-right: 2rem;
      }
      #mobile-menu.active {
        transform: translateX(0);
      }
      .mobile-menu-open {
        overflow: hidden;
      }
      
      /* Dropdown Menu Styles */
      .nav-dropdown {
        position: relative;
        display: flex;
        align-items: center;
      }
      .nav-dropdown-toggle {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
        line-height: 1;
      }
      .nav-dropdown-toggle svg {
        width: 12px;
        height: 12px;
        transition: transform 0.2s ease;
        flex-shrink: 0;
      }
      .nav-dropdown:hover .nav-dropdown-toggle svg {
        transform: rotate(180deg);
      }
      .nav-dropdown-menu {
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        background: white;
        border-radius: 0.5rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
        padding: 0.75rem 0;
        min-width: 180px;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease, visibility 0.2s ease;
        z-index: 100;
        margin-top: 0.5rem;
      }
      .nav-dropdown:hover .nav-dropdown-menu {
        opacity: 1;
        visibility: visible;
      }
      .nav-dropdown-menu a {
        display: block;
        padding: 0.625rem 1.25rem;
        font-size: 0.875rem;
        color: #4b5563;
        transition: background 0.2s ease, color 0.2s ease;
      }
      .nav-dropdown-menu a:hover {
        background: #f3f4f6;
        color: #1565c0;
      }
      
      /* Mobile Dropdown */
      .mobile-dropdown-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
      }
      .mobile-dropdown-toggle svg {
        width: 16px;
        height: 16px;
        transition: transform 0.3s ease;
      }
      .mobile-dropdown.open .mobile-dropdown-toggle svg {
        transform: rotate(180deg);
      }
      .mobile-dropdown-menu {
        max-height: 0;
        overflow: hidden;
        padding-left: 1rem;
        margin-top: 0;
        opacity: 0;
        transition: max-height 0.5s ease, opacity 0.5s ease, margin-top 0.5s ease;
      }
      .mobile-dropdown.open .mobile-dropdown-menu {
        max-height: 200px;
        opacity: 1;
        margin-top: 0.75rem;
      }
      .mobile-dropdown-menu a {
        display: block;
        padding: 0.25rem 0;
        font-size: 1.25rem;
        font-weight: 600;
        color: #4b5563;
      }
      
      /* Scrolled Nav State */
      nav.scrolled {
        background: rgba(255, 255, 255, 0.95) !important;
        border-bottom: 1px solid #e8e8ef;
      }
      nav.scrolled .nav-link {
        color: #4a4a68 !important;
      }
      nav.scrolled .nav-link:hover {
        color: #1565c0 !important;
      }
      nav.scrolled .hamburger-line,
      #menu-toggle.active .hamburger-line {
        background: #1a1a2e !important;
      }
      
      /* Sample Video Section */
      .sample-video-container {
        position: relative;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        aspect-ratio: 9 / 16;
        max-width: 350px;
        margin: 0 auto;
      }
      
      .sample-video-container iframe {
        width: 100%;
        height: 100%;
        border: none;
      }
      
      .sample-video-container video {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      
      /* Horizontal video container (16:9) */
      .sample-video-container.horizontal {
        aspect-ratio: 16 / 9;
        max-width: 100%;
      }
    </style>
  </head>
  <body>
    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 bg-white/30 backdrop-blur-sm border-border py-4 px-6 md:px-8 z-[1000]">
      <div class="max-w-[1200px] mx-auto flex justify-between items-center">
        <a href="/" class="flex items-center no-underline">
          <img src="/images/logo.png" alt="WiseUp Logo" class="h-10 md:h-14 w-auto" />
        </a>
        <div class="flex items-center gap-6">
          <ul class="hidden md:flex gap-8 list-none m-0 p-0">
            <li class="nav-dropdown">
              <a href="/marketing" class="nav-dropdown-toggle nav-link no-underline text-white font-medium text-sm hover:text-white/70 transition-colors duration-300">
                <span data-ko="마케팅" data-en="Marketing">Marketing</span>
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </a>
              <div class="nav-dropdown-menu">
                <a href="/marketing/web" class="no-underline" data-ko="웹 개발" data-en="Web Development">Web Development</a>
                <a href="/marketing/video" class="no-underline" data-ko="영상 제작" data-en="Video Production">Video Production</a>
              </div>
            </li>
            <li><a href="#packages" class="nav-link no-underline text-white font-medium text-sm hover:text-white/70 transition-colors duration-300" data-ko="패키지" data-en="Packages">Packages</a></li>
            <li><a href="#contact" class="nav-link no-underline text-white font-medium text-sm hover:text-white/70 transition-colors duration-300" data-ko="문의하기" data-en="Contact">Contact</a></li>
          </ul>
          <!-- Language Switcher -->
          <div class="lang-switcher" id="lang-switcher">
            <div class="lang-slider" id="lang-slider"></div>
            <button type="button" class="lang-btn" data-lang="ko" id="btn-ko">한</button>
            <button type="button" class="lang-btn active" data-lang="en" id="btn-en">EN</button>
          </div>

          <!-- Hamburger Button -->
          <button id="menu-toggle" class="md:hidden flex flex-col justify-center items-center w-8 h-8 gap-1.5 focus:outline-none z-[1001]">
            <span class="hamburger-line w-6 h-0.5 bg-white transition-all duration-300 origin-center"></span>
            <span class="hamburger-line w-6 h-0.5 bg-white transition-all duration-300"></span>
            <span class="hamburger-line w-6 h-0.5 bg-white transition-all duration-300 origin-center"></span>
          </button>
        </div>
      </div>

      <!-- Mobile Menu Drawer -->
      <div id="mobile-menu" class="md:hidden">
        <ul class="flex flex-col gap-6 list-none m-0 p-0">
          <li class="mobile-dropdown" id="mobile-marketing-dropdown">
            <div class="mobile-dropdown-toggle text-2xl font-bold text-text-dark">
              <span data-ko="마케팅" data-en="Marketing">Marketing</span>
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </div>
            <div class="mobile-dropdown-menu">
              <a href="/marketing" class="mobile-link no-underline" data-ko="마케팅" data-en="Marketing">Marketing</a>
              <a href="/marketing/web" class="mobile-link no-underline" data-ko="웹 개발" data-en="Web Development">Web Development</a>
              <a href="/marketing/video" class="mobile-link no-underline" data-ko="영상 제작" data-en="Video Production">Video Production</a>
            </div>
          </li>
          <li><a href="#packages" class="mobile-link text-2xl font-bold text-text-dark no-underline" data-ko="패키지" data-en="Packages">Packages</a></li>
          <li><a href="#contact" class="mobile-link text-2xl font-bold text-text-dark no-underline" data-ko="문의하기" data-en="Contact">Contact</a></li>
        </ul>
      </div>
    </nav>

    <!-- Fullscreen Video Hero -->
    <header class="video-hero">
      <video class="video-hero-bg" autoplay muted loop playsinline poster="/images/video-hero-poster.jpg">
        <source src="/videos/video-page-background.mp4" type="video/mp4" />
      </video>
      <div class="video-hero-overlay"></div>
      <div class="video-hero-content">
        <div class="hero-fade inline-block bg-gradient-to-br from-primary to-primary-light text-white py-2 px-8 rounded-full text-xs font-semibold uppercase tracking-wider mb-6" data-ko="홍보영상 제작" data-en="Video Production" style="opacity: 0;">Video Production</div>
        <h1 id="hero-title">
          <span id="typing-line-1" class="typing-text" style="opacity: 0;"></span><span id="cursor-1" class="typing-cursor" style="display: none;"></span><br />
          <span id="typing-line-2" class="typing-text" style="opacity: 0;"></span><span id="cursor-2" class="typing-cursor" style="display: none;"></span>
        </h1>
        <p class="hero-fade" data-ko="소상공인과 리얼터를 위한 맞춤형 홍보영상. 첫인상을 결정짓는 강력한 영상 콘텐츠를 제작해 드립니다." data-en="Custom promotional videos for small businesses and realtors. Create powerful video content that makes a lasting first impression." style="opacity: 0;">
          Custom promotional videos for small businesses and realtors. Create powerful video content that makes a lasting first impression.
        </p>
        <div class="hero-fade flex flex-col md:flex-row gap-4 justify-center" style="opacity: 0;">
          <a href="#packages" class="btn btn-primary" data-ko="패키지 보기" data-en="View Packages">View Packages</a>
          <a href="#sample" class="btn btn-secondary bg-white/20 border-white text-white hover:bg-white hover:text-text-dark" data-ko="샘플 영상 보기" data-en="Watch Sample">Watch Sample</a>
        </div>
      </div>
    </header>

    <!-- Sample Video Section -->
    <section id="sample" class="py-20 bg-bg-section">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="text-center mb-12">
          <span class="section-badge" data-ko="샘플 영상" data-en="Sample Video">Sample Video</span>
          <h2 class="text-3xl md:text-4xl font-bold text-text-dark mb-4" data-ko="이런 영상을 만들어 드립니다" data-en="This Is What We Create">This Is What We Create</h2>
          <p class="text-text-muted max-w-[600px] mx-auto" data-ko="고객의 브랜드와 비즈니스를 돋보이게 하는 프로페셔널 영상" data-en="Professional videos that make your brand and business stand out">Professional videos that make your brand and business stand out</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-10 gap-8 md:gap-16 items-center">
          <div class="col-span-1 md:col-span-3">
            <div class="sample-video-container">
              <video controls playsinline poster="/images/golfland-poster.jpg">
                <source src="/videos/golfland.mp4" type="video/mp4" />
                Your browser does not support the video tag.
              </video>
            </div>
          </div>

          <div class="col-span-1 md:col-span-7">
            <div class="sample-video-container horizontal">
              <video controls playsinline poster="/images/golfland-3-poster.jpg">
                <source src="/videos/golfland-3-subtitles.mp4" type="video/mp4" />
                Your browser does not support the video tag.
              </video>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Packages -->
    <section id="packages" class="py-20">
      <div class="max-w-[1250px] mx-auto px-6">
        <div class="text-center mb-16">
          <span class="section-badge" data-ko="영상 패키지" data-en="Video Packages">Video Packages</span>
          <h2 class="text-3xl md:text-4xl font-bold text-text-dark mb-4" data-ko="비즈니스 목적에 맞는 패키지 선택" data-en="Choose the Right Package for Your Business">Choose the Right Package for Your Business</h2>
          <p class="text-text-muted max-w-[600px] mx-auto" data-ko="소상공인, 리얼터, 레스토랑 등 다양한 비즈니스에 최적화된 영상 패키지" data-en="Video packages optimized for small businesses, realtors, restaurants, and more">Video packages optimized for small businesses, realtors, restaurants, and more</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Basic Package -->
            <div class="pricing-card">
              <div class="card-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                </svg>
              </div>
              <span class="card-tier">01</span>
              <h3 class="card-title">Basic</h3>
              <p class="card-tagline" data-ko="영상 마케팅을 처음 시작하는 소상공인을 위한 심플한 홍보 영상" data-en="Small businesses trying video for the first time. Simple promotional or introductory content.">Small businesses trying video for the first time. Simple promotional or introductory content.</p>

              <div class="card-price">
                <span class="currency">$</span>
                <span class="amount">450</span>
                <span class="suffix">+</span>
              </div>

              <div class="card-meta">
                <div class="card-meta-item">
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span data-ko="5 - 7 영업일" data-en="5 - 7 business days">5 - 7 business days</span>
                </div>
              </div>

              <ul class="card-features">
                <li>
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span><strong data-ko="2개 세로 (15~30초) & 1개 가로 (30~60초) 영상" data-en="2 × Vertical (15–30s) & 1 × Horizontal (30–60s)">2 × Vertical (15–30s) & 1 × Horizontal (30–60s)</strong></span>
                </li>
                <li>
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span><strong data-ko="최대 1시간 촬영 (단일 장소)" data-en="Up to 1 hour of filming (Single location)">Up to 1 hour of filming (Single location)</strong></span>
                </li>
                <li>
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span><strong data-ko="1회 편집 수정 포함" data-en="1 editing revision included">1 editing revision included</strong></span>
                </li>
                <li>
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  <span><strong data-ko="촬영 후 5-7 영업일 이내 납품" data-en="Delivery in 5-7 business days">Delivery in 5-7 business days</strong></span>
                </li>
              </ul>
            <span class="tax-note text-right" data-ko="* HST 별도" data-en="* HST extra">* HST extra</span>

            <a href="mailto:hans@wiseupsolution.ca?subject=Video%20Basic%20Package%20Inquiry" class="card-cta" data-ko="시작하기" data-en="Get Started">Get Started</a>
          </div>

          <!-- Standard Package -->
          <div class="pricing-card featured">
            <span class="card-badge" data-ko="⭐ 가장 인기" data-en="⭐ Most Popular">⭐ Most Popular</span>
            <div class="card-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2m-9 0h10m-10 0a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V6a2 2 0 00-2-2"></path>
              </svg>
            </div>
