    <footer class="py-12 border-t border-border bg-bg-gray">
      <div class="max-w-[1200px] mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
        <a href="/" class="flex items-center no-underline">
          <img src="/images/logo.png" alt="WiseUp Logo" class="h-10 w-auto" />
        </a>
        <p class="text-text-muted text-sm">© 2026 WiseUp Solution. All rights reserved.</p>
      </div>
    </footer>

    <script>
      // Language toggle functionality
      const STORAGE_KEY = 'wiseup-lang';
      let currentLang = 'en';
      
      function setLanguage(lang: string, animate = true) {
        if (lang === currentLang && animate) return;
        
        const textElements = document.querySelectorAll<HTMLElement>('[data-ko][data-en]');
        const htmlElements = document.querySelectorAll<HTMLElement>('[data-html-ko][data-html-en]');
        const allElements = [...textElements, ...htmlElements];
        
        if (animate && allElements.length > 0) {
          allElements.forEach(el => {
            el.style.transition = 'opacity 0.25s ease';
            el.style.opacity = '0';
          });
          
          setTimeout(() => {
            textElements.forEach(el => {
              const text = el.getAttribute(`data-${lang}`);
              if (text) {
                el.textContent = text;
              }
            });
            
            htmlElements.forEach(el => {
              const html = el.getAttribute(`data-html-${lang}`);
              if (html) {
                el.innerHTML = html;
              }
            });
            
            setTimeout(() => {
              allElements.forEach(el => {
                if (!el.classList.contains('hero-fade')) {
                  el.style.opacity = '1';
                }
              });
            }, 50);
          }, 250);
        } else {
          textElements.forEach(el => {
            const text = el.getAttribute(`data-${lang}`);
            if (text) {
              el.textContent = text;
            }
          });
          
          htmlElements.forEach(el => {
            const html = el.getAttribute(`data-html-${lang}`);
            if (html) {
              el.innerHTML = html;
            }
          });
        }
        
        document.getElementById('html-root')?.setAttribute('lang', lang);
        
        const title = document.querySelector('title');
        if (title) {
          title.textContent = title.getAttribute(`data-${lang}`) || title.textContent;
        }
        
        const metaDesc = document.querySelector('meta[name="description"]');
        if (metaDesc) {
          const content = metaDesc.getAttribute(`data-${lang}`) || metaDesc.getAttribute('content') || '';
          metaDesc.setAttribute('content', content);
        }

        // Update Open Graph and Twitter tags
        const metaTags = [
          'og:title', 'og:description', 'twitter:title', 'twitter:description'
        ];
        metaTags.forEach(tag => {
          const attr = tag.startsWith('og:') ? 'property' : 'name';
          const el = document.querySelector(`meta[${attr}="${tag}"]`);
          if (el) {
            el.setAttribute('content', el.getAttribute(`data-${lang}`) || el.getAttribute('content'));
          }
        });
        
        const slider = document.getElementById('lang-slider') as HTMLElement | null;
        if (slider) {
          slider.style.transform = lang === 'en' ? 'translateX(36px)' : 'translateX(0)';
        }
        
        document.getElementById('btn-ko')?.classList.toggle('active', lang === 'ko');
        document.getElementById('btn-en')?.classList.toggle('active', lang === 'en');
        
        currentLang = lang;
        localStorage.setItem(STORAGE_KEY, lang);
      }
      
      document.addEventListener('DOMContentLoaded', () => {
        const savedLang = localStorage.getItem(STORAGE_KEY) || 'en';
        currentLang = savedLang;
        setLanguage(savedLang, false);
        
        document.getElementById('btn-ko')?.addEventListener('click', () => setLanguage('ko', true));
        document.getElementById('btn-en')?.addEventListener('click', () => setLanguage('en', true));
        
        // Mobile Menu Toggle
        const menuToggle = document.getElementById('menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');
        const spans = menuToggle?.querySelectorAll<HTMLElement>('span');

        function toggleMenu() {
          mobileMenu?.classList.toggle('active');
          menuToggle?.classList.toggle('active');
          document.body.classList.toggle('mobile-menu-open');
          
          if (mobileMenu?.classList.contains('active') && spans) {
            spans[0].style.transform = 'translateY(8px) rotate(45deg)';
            spans[1].style.opacity = '0';
            spans[2].style.transform = 'translateY(-8px) rotate(-45deg)';
          } else if (spans) {
            spans[0].style.transform = 'none';
            spans[1].style.opacity = '1';
            spans[2].style.transform = 'none';
          }
        }

        menuToggle?.addEventListener('click', toggleMenu);

        mobileLinks.forEach(link => {
          link.addEventListener('click', () => {
            mobileMenu?.classList.remove('active');
            menuToggle?.classList.remove('active');
            document.body.classList.remove('mobile-menu-open');
            if (spans) {
              spans[0].style.transform = 'none';
              spans[1].style.opacity = '1';
              spans[2].style.transform = 'none';
            }
          });
        });

        // Mobile dropdown toggle
        const mobileDropdown = document.getElementById('mobile-marketing-dropdown');
        if (mobileDropdown) {
          const mobileDropdownToggle = mobileDropdown.querySelector('.mobile-dropdown-toggle');
          mobileDropdownToggle?.addEventListener('click', () => {
            mobileDropdown.classList.toggle('open');
          });
        }

        // Revision Definition Accordion Toggle
        const revisionToggle = document.getElementById('revision-accordion-toggle');
        const revisionContent = document.getElementById('revision-accordion-content');
        const revisionIcon = document.getElementById('revision-accordion-icon');
        
        if (revisionToggle && revisionContent && revisionIcon) {
          revisionToggle.addEventListener('click', () => {
            const isOpen = revisionContent.style.maxHeight && revisionContent.style.maxHeight !== '0px';
            
            if (isOpen) {
              revisionContent.style.maxHeight = '0px';
              revisionIcon.style.transform = 'rotate(0deg)';
            } else {
              revisionContent.style.maxHeight = revisionContent.scrollHeight + 'px';
              revisionIcon.style.transform = 'rotate(180deg)';
            }
          });
        }
        
        // Scroll-based header style
        const nav = document.querySelector('nav');
        const heroSection = document.querySelector('.video-hero') as HTMLElement | null;
        
        function handleScroll() {
          const heroHeight = heroSection ? heroSection.offsetHeight : 600;
          if (window.scrollY > heroHeight - 100) {
            nav?.classList.add('scrolled');
          } else {
            nav?.classList.remove('scrolled');
          }
        }
        
        window.addEventListener('scroll', handleScroll);
        handleScroll(); // Check initial state
        
        // Terminal typing animation
        const typingTexts = {
          en: [
            { text: 'Tell Your Story Through', html: 'Tell Your Story Through' },
            { text: 'Professional Video', html: 'Professional <span class="video-gradient-text">Video</span>' }
          ],
          ko: [
            { text: '영상으로 전하는', html: '<span class="video-gradient-text">영상</span>으로 전하는' },
            { text: '브랜드 스토리', html: '브랜드 스토리' }
          ]
        };
        
        let isTyping = false;
        
        async function typeText(element: HTMLElement, text: string, finalHtml: string, cursorId: string) {
          const cursor = document.getElementById(cursorId);
          if (cursor) cursor.style.display = 'inline-block';
          element.innerHTML = '';
          element.style.opacity = '1'; // Ensure title lines are visible
          for (let i = 0; i <= text.length; i++) {
            if (!isTyping) return;
            element.textContent = text.substring(0, i);
            
            // Natural human-like timing: random base speed with extra pause for spaces
            const char = text[i-1];
            let delay = 40 + Math.random() * 80; // Random delay between 40ms and 120ms
            
            if (char === ' ') {
              delay += 100; // Pause longer on spaces
            }
            
            // Occasional "thoughtful" pause (slight hesitation)
            if (Math.random() > 0.9) {
              delay += 200;
            }

            await new Promise(resolve => setTimeout(resolve, delay));
          }
          element.innerHTML = finalHtml;
          
          // Trigger gradient transition
          const gradientElement = element.querySelector('.video-gradient-text');
          if (gradientElement) {
            // Small delay to ensure browser paints the white text first
            setTimeout(() => {
              gradientElement.classList.add('active');
            }, 50);
          }
          
          if (cursor) cursor.style.display = 'none';
        }
        
        async function runTypingAnimation() {
          isTyping = true;
          const lang = currentLang as 'en' | 'ko';
          const texts = typingTexts[lang];
          const line1 = document.getElementById('typing-line-1');
          const line2 = document.getElementById('typing-line-2');
          
          if (line1 && line2) {
            // Hide fade elements during typing and clear any inline opacity from setLanguage
            document.querySelectorAll('.hero-fade').forEach(el => {
              el.classList.remove('visible');
              (el as HTMLElement).style.opacity = '0';
            });
            
            line1.innerHTML = '';
            line2.innerHTML = '';
            await typeText(line1, texts[0].text, texts[0].html, 'cursor-1');
            await new Promise(resolve => setTimeout(resolve, 200));
            await typeText(line2, texts[1].text, texts[1].html, 'cursor-2');
            
            // Fade in other elements after typing completes
            const fadeElements = document.querySelectorAll('.hero-fade');
            fadeElements.forEach((el, index) => {
              setTimeout(() => {
                el.classList.add('visible');
                (el as HTMLElement).style.opacity = '1';
              }, index * 200);
            });
          }
        }
        
        // Run on load
        setTimeout(runTypingAnimation, 500);
        
        // Re-run on language switch
        document.getElementById('btn-ko')?.addEventListener('click', () => {
          isTyping = false;
          setTimeout(runTypingAnimation, 400);
        });
        document.getElementById('btn-en')?.addEventListener('click', () => {
          isTyping = false;
          setTimeout(runTypingAnimation, 400);
        });
      });
    </script>
  </body>
