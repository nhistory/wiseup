          <a href="#" class="text-text-muted text-sm hover:text-primary transition-colors no-underline">Facebook</a>
          <a href="#" class="text-text-muted text-sm hover:text-primary transition-colors no-underline">Instagram</a>
          <a href="#" class="text-text-muted text-sm hover:text-primary transition-colors no-underline">Twitter</a>
        </div>
      </div>
